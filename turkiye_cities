import json
import os

# اسم الملف الذي يحتوي على بيانات الـ 81 مدينة
input_file = "all_turkey_cities.json"
output_dir = "cities"

os.makedirs(output_dir, exist_ok=True)

with open(input_file, "r", encoding="utf-8") as f:
    data = json.load(f)

# جلب مدن تركيا
cities_data = data.get("turkiye", {}).get("cities", {})

for city_id, city_info in cities_data.items():
    city_info["city_id"] = city_id
    
    # حفظ كل مدينة بملف خاص مثل: cities/adana.json
    file_path = os.path.join(output_dir, f"{city_id}.json")
    with open(file_path, "w", encoding="utf-8") as out:
        json.dump(city_info, out, ensure_ascii=False, indent=2)

print(f"تم إنشاء {len(cities_data)} ملف مدينة بنجاح داخل مجلد '{output_dir}'!")
